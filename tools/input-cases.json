    "source": ": f 5 0 do i dup 2 = if unloop exit then loop ; f"
  },
  {
    "name": "recurse",
    "source": ": f dup 2 < if drop 1 exit then dup 1- recurse * ; 5 f"
  },
  {
    "name": "xt",
    "source": ": f 4 ; ' f constant old : f 8 ; old execute f"
  },
  {
